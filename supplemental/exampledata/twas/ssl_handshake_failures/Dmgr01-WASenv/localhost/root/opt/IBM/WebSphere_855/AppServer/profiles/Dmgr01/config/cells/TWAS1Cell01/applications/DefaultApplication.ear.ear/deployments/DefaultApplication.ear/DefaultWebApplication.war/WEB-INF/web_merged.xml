<?xml version="1.0" encoding="UTF-8"?><web-app id="WebApp_ID" version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <description>This is the IBM WebSphere Application Server Default Web Application.</description>
    <display-name>Default Web Application</display-name>
    <servlet>
        <description>This servlet returns information about the request which includes information about  existing sessions, application attributes, and request attributes.</description>
        <servlet-name>Snoop Servlet</servlet-name>
        <servlet-class>SnoopServlet</servlet-class>
    </servlet>
    <servlet>
        <description>This servlet demonstrates the various ways to increment a counter. The methods used are: Servlet instance variable, Session object, and JPA.</description>
        <servlet-name>Hit Count Servlet</servlet-name>
        <servlet-class>HitCount</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Snoop Servlet</servlet-name>
        <url-pattern>/snoop/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Hit Count Servlet</servlet-name>
        <url-pattern>/hitcount</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    <error-page>
        <error-code>401</error-code>
        <location>/auth_error.jsp</location>
    </error-page>
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Snoop Servlet</web-resource-name>
            <description>Protection area for Snoop Servlet.</description>
            <url-pattern>/snoop/*</url-pattern>
            <url-pattern>/servlet/SnoopServlet/*</url-pattern>
            <http-method>GET</http-method>
            <http-method>POST</http-method>
        </web-resource-collection>
        <auth-constraint>
            <description>Snoop Servlet Security:+:All Authenticated users for Snoop Servlet.</description>
            <role-name>All Role</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-role>
        <description>All Authenticated Users Role.</description>
        <role-name>All Role</role-name>
    </security-role>
    <ejb-local-ref>
        <ejb-ref-name>HitCount/inc</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.ibm.defaultapplication.IncrementSSB</local>
        <injection-target>
            <injection-target-class>HitCount</injection-target-class>
            <injection-target-name>inc</injection-target-name>
        </injection-target>
    </ejb-local-ref>
    <resource-env-ref>
        <resource-env-ref-name>HitCount/tx</resource-env-ref-name>
        <resource-env-ref-type>javax.transaction.UserTransaction</resource-env-ref-type>
        <injection-target>
            <injection-target-class>HitCount</injection-target-class>
            <injection-target-name>tx</injection-target-name>
        </injection-target>
    </resource-env-ref>
</web-app>
